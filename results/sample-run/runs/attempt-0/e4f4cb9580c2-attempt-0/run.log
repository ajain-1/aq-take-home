Sending keys: ['cat > csv_to_json.py << \'EOF\'\nimport sys\nimport os\nimport json\n\ndef main():\n    # Parse arguments\n    args = sys.argv[1:]\n    pretty = False\n    path = None\n    \n    for arg in args:\n        if arg == \'--pretty\':\n            pretty = True\n        elif not arg.startswith(\'-\'):\n            path = arg\n    \n    if path is None:\n        print("usage: python csv_to_json.py [--pretty] <input.csv>", file=sys.stderr)\n        sys.exit(2)\n    \n    # Get delimiter from environment variable, default to comma\n    delimiter = os.environ.get(\'DELIM\', \',\')\n    \n    rows = []\n    with open(path, "r", encoding="utf-8") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split(delimiter)\n            rows.append(parts)\n    \n    if not rows:\n        result = []\n    else:\n        # First row is header\n        header = rows[0]\n        data_rows = rows[1:]\n        \n        # Convert to list of dicts\n        result = []\n        for row in data_rows:\n            obj = {}\n            for i, key in enumerate(header):\n                if i < len(row):\n                    obj[key] = row[i]\n                else:\n                    obj[key] = \'\'\n            result.append(obj)\n    \n    # Output JSON\n    if pretty:\n        output = json.dumps(result, ensure_ascii=False, indent=2)\n    else:\n        output = json.dumps(result, ensure_ascii=False)\n    \n    # Write to stdout with UTF-8 encoding\n    sys.stdout.write(output + \'\\n\')\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.0 max_timeout_sec: 5.0
